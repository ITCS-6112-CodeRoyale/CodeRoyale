{
    "ConnectionStrings":
    {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=aspnet-CodeRoyale-20fadd51-b8e4-418a-b3d9-97885706d2aa;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    "Serilog":
    {
        "MinimumLevel":
        {
            "Default": "Information",
            "Override":
            {
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.Extensions.Http.DefaultHttpClientFactory": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "WriteTo":
        [
            {
                "Name": "Console",
                "Args":
                {
                    "formatter":
                    {
                        "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                        "template": "[{@t:HH:mm:ss} {@l:u3}] [{Substring(SourceContext, LastIndexOf(SourceContext, '.') + 1)}] {@m}\n{@x}",
                        "theme": "Serilog.Templates.Themes.TemplateTheme::Code, Serilog.Expressions"
                    }
                }
            }
        ],
        "Enrich":
        [
            "FromLogContext"
        ]
    },
    "AllowedHosts": "*"
}
