@implements IDisposable

@inject NavigationManager NavigationManager

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="">
            <span class="brand-name">Code<span class="accent">Royale</span></span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" title="Navigation menu" />
        <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle navigation">
            <span></span><span></span><span></span>
        </label>

        <nav class="nav-links" onclick="document.getElementById('nav-toggle').checked = false">
            <NavLink class="nav-pill" href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="nav-pill" href="join">Join a game</NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-pill" href="host">Host a game</NavLink>
                    <NavLink class="nav-pill" href="questions">Question Sets</NavLink>
                    <NavLink class="nav-pill nav-user" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                    <form action="Account/Logout" method="post" class="nav-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-pill nav-button">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-pill" href="Account/Register">Register</NavLink>
                    <NavLink class="nav-pill nav-cta" href="Account/Login">Log in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
