@page "/play/{JoinCodeParam}"
@using System.Collections.Immutable
@using System.Globalization
@using System.Net
@using System.Text.RegularExpressions
@using CodeRoyale.CodeRunner
@using CodeRoyale.Data
@using CodeRoyale.Data.Games
@using CodeRoyale.Data.Questions
@using CodeRoyale.Identity
@using CodeRoyale.Live

@implements IDisposable
@inject GameService Games
@inject CodeEntryTestService CodeTestService
@inject NavigationManager Nav
@inject ApplicationUserProvider UserProvider
@inject ILogger<Play> Logger

<PageTitle>CodeRoyale</PageTitle>

@if (game is null)
{
    <h1>Game not found</h1>
    <p class="text-muted">
        No game is running with the code <code>@JoinCodeParam</code>. It may have finished, or the code may be wrong.
    </p>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" href="/join">Try another code</a>
        <a class="btn btn-outline-secondary" href="/host">Host your own</a>
    </div>
}
else if (me is null)
{
    <h1>You are not in this game</h1>
    <p class="text-muted">This game exists, but you do not have a seat in it.</p>
    <a class="btn btn-primary" href="@($"/join?code={game.JoinCode}")">Join game @game.JoinCode</a>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-0">@game.Deck.Name</h1>
            <span class="text-muted small">
                Playing as <strong>@me.Name</strong>@(_isHost ? " (host)" : "")
            </span>
        </div>
        <div class="text-end">
            <div class="small text-muted">Join code</div>
            <div class="fs-3 fw-bold" style="letter-spacing: 0.25em; font-family: monospace;">@game.JoinCode</div>
        </div>
    </div>

    @if (actionError is not null)
    {
        <div class="alert alert-warning">@actionError</div>
    }

    @* ---------------------------------------------------------------- lobby *@
    @if (game.Phase == GamePhase.Lobby)
    {
        <div class="alert alert-info">
            Share the code <strong>@game.JoinCode</strong> &mdash; or send this link:
            <code>@($"{Nav.BaseUri}join?code={game.JoinCode}")</code>
        </div>

        <h2 class="h5">Players (@game.Players.Count)</h2>
        <ul class="list-group mb-4" style="max-width: 32rem;">
            @foreach (GamePlayer p in game.Players.Values.OrderByDescending(x => x.IntlGameId == game.HostPlayerId).ThenBy(x => x.Name))
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@p.Name</span>
                    <span>
                        @if (p.IntlGameId == game.HostPlayerId)
                        {
                            <span class="badge bg-secondary">host</span>
                        }
                        @if (p.IntlGameId == me.IntlGameId)
                        {
                            <span class="badge bg-primary">you</span>
                        }
                    </span>
                </li>
            }
        </ul>

        @if (_isHost)
        {
            <button class="btn btn-success btn-lg" @onclick="StartGame">
                Start game (@game.QuestionCount questions)
            </button>
            <p class="form-text">Starting the game closes it to new players.</p>
        }
        else
        {
            <p class="text-muted">Waiting for the host to start&hellip;</p>
        }
    }

    @* ------------------------------------------------------------- question *@
    else if (game.Phase == GamePhase.Question && _currentQuestion is not null)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted">Question @game.QuestionNumber of @game.QuestionCount</span>
            <span class="fs-4 fw-bold @(SecondsLeft <= 5 ? "text-danger" : "")">@SecondsLeft s</span>
        </div>
        <div class="progress mb-4" style="height: 0.5rem;">
            <div class="progress-bar @(TimePercent < 25 ? "bg-danger" : TimePercent < 50 ? "bg-warning" : "bg-success")"
                 style="width: @TimePercent%;"></div>
        </div>
        
        @if (_currentQuestion is not BlankEntryQuestion)
        {
            <h2 class="h3 mb-3">@(new MarkupString(_currentQuestion.Text))</h2>
        }
        else
        {
            <h2 class="h3 mb-3">Blank Entry Question</h2>
        }

        @if (me.HasAnswered(game.CurrentIndex))
        {
            <div class="alert alert-success">Answer locked in. Waiting for the other players&hellip;</div>
            
            @switch (_currentQuestion)
            {
                case MultipleChoiceQuestion mcq:

                    <ul class="list-group" style="max-width: 44rem;">
                        @foreach (MultipleChoiceAnswer answer in GetShuffledAnswers(mcq))
                        {
                            <li class="list-group-item opt-@answer.Index @(MyAnswerIndex == answer.Id ? "active" : "opacity-50")">@(new MarkupString(answer.Text))</li>
                        }
                    </ul>
                    break;

                case CodeEntryQuestion when _codeEntryResult != null:
                    <div class="container">
                        
                        <label for="ceq_code" class="form-label">Code</label>
                        <textarea id="ceq_code" class="form-control font-monospace" rows="16" value="@Code" disabled></textarea>

                    </div>
                    break;

                case BlankEntryQuestion when _blanksFilledIn.Value != null:
                    <p>@_blanksFilledIn</p>
                    break;
            }
        }
        else
        {
            @switch (_currentQuestion)
            {
                case MultipleChoiceQuestion mcq:
            
                    <div class="d-grid gap-2 answer-grid" style="max-width: 44rem;">
                        @foreach (MultipleChoiceAnswer answer in GetShuffledAnswers(mcq))
                        {
                            int idx = answer.Index;
                            <button class="btn @OptionClass(idx) btn-lg text-start py-3" @onclick="() => AnswerMultipleChoice(idx, mcq)">
                                @(new MarkupString(answer.Text))
                            </button>
                        }
                    </div>
                    break;

                case CodeEntryQuestion:

                    <div class="container mb-2">
                        
                        <label for="ceq_code" class="form-label">Code</label>
                        <textarea id="ceq_code" class="form-control font-monospace" rows="16" value="@Code" @onchange="value => Code = value.Value?.ToString()"></textarea>

                    </div>

                    <button class="btn btn-primary" @onclick="AnswerCodeEntryQuestion">Submit</button>
                    break;

                case BlankEntryQuestion beq when _blankAnswers != null:

                    <p>
                        @foreach ((MarkupString segment, int blank) in GetBlankSegments(beq))
                        {
                            @if (!string.IsNullOrEmpty(segment.Value))
                            {
                                <span>@segment</span>
                            }
                            @if (blank != -1)
                            {
                                <input type="text" class="d-inline" size="32" value="@_blankAnswers[blank]" @onchange="e => _blankAnswers[blank] = e.Value?.ToString()">
                            }
                        }
                    </p>
                    
                    @if (!Array.Exists(_blankAnswers, string.IsNullOrWhiteSpace))
                    {
                        <button class="btn btn-primary" @onclick="AnswerBlankEntryQuestion">Submit</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled>Submit</button>
                    }
                    break;
            }
        }

        <p class="text-muted small mt-4">
            Answer faster for more points: full marks instantly, half marks at the buzzer.
        </p>
    }

    @* --------------------------------------------------------------- reveal *@
    else if (game.Phase == GamePhase.Reveal && _currentQuestion is not null)
    {
        <span class="text-muted">Question @game.QuestionNumber of @game.QuestionCount</span>

        @if (_currentQuestion is not BlankEntryQuestion)
        {
            <h2 class="h4 mb-3">@(new MarkupString(_currentQuestion.Text))</h2>
        }
        else
        {
            <h2 class="h4 mb-3">Blank Entry Question</h2>
        }

        @switch (_currentQuestion)
        {
            case MultipleChoiceQuestion mcq:
            
                <ul class="list-group mb-4" style="max-width: 44rem;">
                    @foreach (MultipleChoiceAnswer answer in mcq.Answers)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center opt-@answer.Index @(answer.IsCorrect ? "list-group-item-success" : MyAnswerIndex == answer.Id ? "list-group-item-danger" : "opacity-50")">
                            <span>@(new MarkupString(answer.Text))</span>
                            <span>
                                @if (answer.IsCorrect)
                                {
                                    <span class="badge bg-success">correct</span>
                                }
                                @if (MyAnswerIndex == answer.Id)
                                {
                                    <span class="badge bg-primary">your answer</span>
                                }
                            </span>
                        </li>
                    }
                </ul>
                break;

            case CodeEntryQuestion when _codeEntryResult != null:

                @if (!string.IsNullOrEmpty(Code))
                {
                    <div class="container">
                        
                        <label for="ceq_code" class="form-label">Code</label>
                        <textarea id="ceq_code" class="form-control" rows="16" value="@Code" disabled></textarea>

                    </div>
                }

                <h3 class="h5 mb-3">Test results</h3>

                if (_codeEntryResult.IsCorrect)
                {
                    <p class="mb-2">✅ @(_codeEntryResult.PassedCorrectTests.Count + _codeEntryResult.FailedIncorrectTests.Count) passed</p>
                }
                else
                {
                    @if (_codeEntryResult.FailedCorrectTests.Count + _codeEntryResult.PassedIncorrectTests.Count > 0)
                    {
                        <p class="mb-1">❌ @(_codeEntryResult.FailedCorrectTests.Count + _codeEntryResult.PassedIncorrectTests.Count) failed</p>
                        <ul class="list-group mb-2">
                            @foreach (TestResult test in _codeEntryResult.FailedCorrectTests.Concat(_codeEntryResult.PassedIncorrectTests).OrderBy(x => x.Test.Index))
                            {
                                @if (test.Reason != null)
                                {
                                    <li class="list-group-item">@(new MarkupString(test.Test.Description)) - @test.Reason</li>
                                }
                                else
                                {
                                    <li class="list-group-item">@(new MarkupString(test.Test.Description))</li>
                                }
                            }
                        </ul>
                    }

                    @if (_codeEntryResult.PassedCorrectTests.Count + _codeEntryResult.FailedIncorrectTests.Count > 0)
                    {
                        <p class="mb-2">✅ @(_codeEntryResult.PassedCorrectTests.Count + _codeEntryResult.FailedIncorrectTests.Count) passed</p>
                        <ul class="list-group mb-2">
                            @foreach (TestResult test in _codeEntryResult.PassedCorrectTests.Concat(_codeEntryResult.FailedIncorrectTests).OrderBy(x => x.Test.Index))
                            {
                                @if (test.Reason != null)
                                {
                                    <li class="list-group-item">@(new MarkupString(test.Test.Description)) - @test.Reason</li>
                                }
                                else
                                {
                                    <li class="list-group-item">@(new MarkupString(test.Test.Description))</li>
                                }
                            }
                        </ul>
                    }

                    @if (!string.IsNullOrEmpty(_codeEntryResult.UserError))
                    {
                        <p class="mb-2">❌ Error encountered while grading</p>
                        <pre class="font-monospace">@_codeEntryResult.UserError</pre>
                    }
                }
                break;

            case BlankEntryQuestion when _regexErrors != null:
                <h3 class="h5 mb-3">Results</h3>
                <p>@_blanksFilledIn</p>

                List<(int i, MarkupString str)> failures = _regexErrors.Index().Where(x => !string.IsNullOrEmpty(x.Item.Value)).ToList();
                @if (failures.Count > 0)
                {
                    @if (failures.Count == _regexErrors.Length)
                    {
                        <p>❌ Incorrect</p>
                    }
                    else
                    {
                        <p><strong>@(_regexErrors.Length - failures.Count) / @_regexErrors.Length</strong> Correct - @(((double)failures.Count / _regexErrors.Length).ToString("P0", CultureInfo.CurrentUICulture))</p>
                    }

                    <ul class="list-group mb-2">
                        @foreach ((int i, MarkupString str) in failures)
                        {
                            <li>❌ Blank #@(i + 1): @str</li>
                        }
                    </ul>
                }
                else
                {
                    <p>✅ Correct</p>
                }

                break;
        }

        @if (MyAnswer is null)
        {
            <div class="alert alert-secondary">You did not answer in time. No points.</div>
        }
        else if (MyAnswer.CorrectPoints == MyAnswer.TotalPoints)
        {
            <div class="alert alert-success">
                Correct in @MyAnswer.AnswerTime.TotalSeconds.ToString("0.0")s &mdash;
                <strong>+@MyAnswer.Score</strong> points
            </div>
        }
        else if (MyAnswer.CorrectPoints > 0)
        {
            <div class="alert alert-warning">
                @(((double)MyAnswer.CorrectPoints / MyAnswer.TotalPoints).ToString("P0", CultureInfo.CurrentUICulture)) correct in @MyAnswer.AnswerTime.TotalSeconds.ToString("0.0")s &mdash;
                <strong>+@MyAnswer.Score</strong> points
            </div>
        }
        else
        {
            <div class="alert alert-danger">Not quite. No points this round.</div>
        }

        @ScoreTable(false)

        <p class="text-muted small">Next question in @SecondsLeft s&hellip;</p>
    }

    @* ---------------------------------------------------------------- final *@
    else if (game.Phase == GamePhase.Completed)
    {
        <h2 class="h3">Final scores</h2>
        <p class="text-muted">@game.QuestionCount questions &middot; @game.Players.Count players</p>

        @ScoreTable(true)

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" href="/host">Host another game</a>
            <a class="btn btn-outline-secondary" href="/join">Join a different game</a>
        </div>
    }
    else if (game.Phase == GamePhase.Ended)
    {
        <h2 class="h3">Game Ended</h2>
        <p class="text-muted">The host ended the game early</p>
    }
}

@code {
    [Parameter] public string JoinCodeParam { get; set; } = string.Empty;

    private Question? _cachedQuestion;

    private MultipleChoiceAnswer[]? _shuffledAnswers;

    private CodeEntryTestResult? _codeEntryResult;
    private Question? _currentQuestion;

    private MarkupString _blanksFilledIn;

    private MarkupString[]? _regexErrors;

    private ArraySegment<(MarkupString segment, int blank)> _blanksUnfilled;

    private string?[]? _blankAnswers;

    private string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "p")]
    private string? PlayerId { get; set; }

    private LiveGame? game;
    private GamePlayer? me;
    private string? actionError;

    private bool _isHost;

    private ApplicationUser? _user;

    /// <summary>
    /// Re-renders twice a second so the countdown moves. Game state changes arrive
    /// separately through GameService.GameChanged; this only drives the clock.
    /// </summary>
    private Timer? ticker;

    private int SecondsLeft => game?.SecondsLeft(DateTime.UtcNow) ?? 0;

    private int TimePercent
    {
        get
        {
            if (game is null) return 0;
            double total = Math.Max(1d, game.CurrentQuestion?.SecondsDuration ?? game.Deck.SecondsPerQuestion);
            return Math.Clamp((int)(100.0 * SecondsLeft / total), 0, 100);
        }
    }

    private GamePlayerQuestionResult? MyAnswer =>
        game is not null && me is not null && me.Answers.TryGetValue(game.CurrentIndex, out GamePlayerQuestionResult? a)
            ? a
            : null;

    private int MyAnswerIndex
    {
        get
        {
            GamePlayerQuestionResult? myAnswer = MyAnswer;
            return myAnswer == null || !int.TryParse(myAnswer.Response, CultureInfo.InvariantCulture, out int n) ? -1 : n;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Games.GameChanged += OnGameChanged;

        _user = await UserProvider.GetLoggedInUserAsync();

        if (me is { UserId: not null } && !string.Equals(me.UserId, _user!.Id, StringComparison.Ordinal))
            me = null;

        ticker = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
    }


    private IList<MultipleChoiceAnswer> GetShuffledAnswers(MultipleChoiceQuestion question)
    {
        if (question == _cachedQuestion)
            return (IList<MultipleChoiceAnswer>?)_shuffledAnswers ?? question.Answers;
            
        MultipleChoiceAnswer[] answers = question.Answers.ToArray();
        if (question.RandomizeAnswers ?? game!.RandomizeAnswers)
        {
            new Random(me!.Seed).Shuffle(answers);
        }
        else
        {
            Array.Sort(answers, (a, b) => a.Index.CompareTo(b.Index));
        }
        
        _shuffledAnswers = answers;
        _cachedQuestion = question;
        return answers;
    }

    private ArraySegment<(MarkupString segment, int blank)> GetBlankSegments(BlankEntryQuestion question)
    {
        if (_cachedQuestion == question)
            return _blanksUnfilled;

        ImmutableArray<BlankEntryDataSpan> spans = question.GetSpans();

        (MarkupString segment, int blank)[] array = new (MarkupString segment, int blank)[spans.Length];
        for (int i = 0; i < array.Length; ++i)
        {
            BlankEntryDataSpan span = spans[i];
            array[i] = (new MarkupString(span.Prefix.ToString()), span.AnswerIndex);
        }

        _blanksUnfilled = array;
        _cachedQuestion = question;
        return array;
    }

    protected override void OnParametersSet()
    {
        game = Games.Find(JoinCodeParam);
        me = game != null && PlayerId != null
            ? game.Players.GetValueOrDefault(PlayerId)
            : null;
        _isHost = me != null && game != null && game.HostPlayerId == me.IntlGameId;
        if (game != null)
        {
            UpdateCurrentQuestion();
        }
    }

    private void UpdateCurrentQuestion()
    {
        if (_currentQuestion == game!.CurrentQuestion)
            return;

        _currentQuestion = game.CurrentQuestion;
        if (string.IsNullOrEmpty(Code))
        {
            if (game!.CurrentQuestion is CodeEntryQuestion ceq)
            {
                Code ??= ceq.StartingText;
            }
            else
            {
                Code = null;
            }
        }

        if (game!.CurrentQuestion is BlankEntryQuestion beq)
        {
            _blankAnswers = new string[beq.Answers.Count];
        }
        else
        {
            _blankAnswers = null;
        }
    }

    private void OnGameChanged(string joinCode)
    {
        if (!string.Equals(joinCode, game?.JoinCode, StringComparison.OrdinalIgnoreCase)) return;
        UpdateCurrentQuestion();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Games.GameChanged -= OnGameChanged;
        ticker?.Dispose();

        if (game == null)
            return;
        if (_isHost)
            Games.StartEndingGame(game.JoinCode);
        else if (me != null)
            Games.LeaveGame(game.JoinCode, me);
    }

    private void StartGame()
    {
        if (game is null || me is null) return;

        if (!_isHost)
            actionError = "Only the host can start the game";
        else
            actionError = Games.Start(game.JoinCode);
    }

    private void AnswerMultipleChoice(int optionIndex, Question question)
    {
        if (game is null || me is null) return;
        actionError = Games.SubmitMultipleChoiceAnswer(game.JoinCode, me.IntlGameId!, question, optionIndex);
    }

    private void AnswerCodeEntryQuestion()
    {
        string? code = Code;
        if (game is null || me is null || string.IsNullOrEmpty(code) || game.CurrentQuestion is not CodeEntryQuestion ceq) return;

        DateTime answerTime = DateTime.UtcNow;

        _ = Task.Run(async () =>
        {
            try
            {
                CodeEntryTestProcessor processor = CodeTestService.CreateProcessor(answerTime, ceq, game!.Deck.Language, code);
                _codeEntryResult = await processor.ProcessAsync(game.CancellationToken);
                actionError = Games.SubmitCodeEntryAnswer(game.JoinCode, me.IntlGameId!, ceq, code, _codeEntryResult);
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) when (game.CancellationToken.IsCancellationRequested) { }
            catch (Exception ex)
            {
                actionError = ex.GetType().Name + " - " + ex.Message;
            }
        });
    }

    private void AnswerBlankEntryQuestion()
    {
        string?[]? answers = _blankAnswers;
        if (game is null || me is null || answers == null || game.CurrentQuestion is not BlankEntryQuestion beq || Array.Exists(answers, string.IsNullOrWhiteSpace)) return;
        
        DateTime answerTime = DateTime.UtcNow;

        _ = Task.Run(async () =>
        {
            try
            {
                _blanksFilledIn = beq.RecombineAnswers(answers);

                MarkupString[] regexErrors = new MarkupString[beq.Answers.Count];
                int correct = 0;
                for (int i = 0; i < beq.Answers.Count; ++i)
                {
                    string? value = answers[i];
                    if (string.IsNullOrEmpty(value))
                    {
                        regexErrors[i] = new MarkupString("Unanswered");
                        continue;
                    }
                        
                    BlankEntryAnswer answer = beq.Answers[i];
                    try
                    {
                        Regex regex = new Regex(answer.CorrectRegex, answer.RegexFlags & ~RegexOptions.Compiled, BlankEntryAnswer.RegexTimeout);
                        if (regex.IsMatch(value.AsSpan().Trim()))
                        {
                            ++correct;
                        }
                        else
                        {
                            regexErrors[i] = new MarkupString($"Incorrect, expected a value matching <code>{WebUtility.HtmlEncode(answer.CorrectRegex)}</code>.");
                        }
                    }
                    catch (RegexMatchTimeoutException)
                    {
                        regexErrors[i] = new MarkupString("<span class=\"text-danger\">Evaluation timed out.</span>");
                    }
                    catch (Exception ex)
                    {
                        regexErrors[i] = new MarkupString($"<span class=\"text-danger\">Evaluation errored: {WebUtility.HtmlEncode(ex.Message)}.</span>");
                        Logger.LogWarning(ex, "Error solving regex: \"{Regex}\" for answer \"{Answer}\".", answer.CorrectRegex, value);
                    }
                }

                actionError = Games.SubmitBlankEntryAnswer(game.JoinCode, me.IntlGameId!, beq, answerTime, _blanksFilledIn.Value, correct);
                _regexErrors = regexErrors;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) when (game.CancellationToken.IsCancellationRequested) { }
            catch (Exception ex)
            {
                actionError = ex.GetType().Name + " - " + ex.Message;
            }
        });
    }

    /// <summary>Bootstrap colour per answer index, so the options read as distinct choices.</summary>
    private static string OptionClass(int index) => index switch
    {
        0 => "btn-opt opt-0",
        1 => "btn-opt opt-1",
        2 => "btn-opt opt-2",
        3 => "btn-opt opt-3",
        _ => "btn-secondary"
    };

    private RenderFragment ScoreTable(bool final) => @<div class="table-responsive mb-3" style="max-width: 44rem;">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 3rem;">#</th>
                    <th scope="col">Player</th>
                    @if (!final)
                    {
                        <th scope="col" class="text-end">This round</th>
                    }
                    <th scope="col" class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ScoreEntry e in Games.Scoreboard(game!))
                {
                    <tr class="@(e.PlayerId == me!.IntlGameId ? "table-active" : "")">
                        <th scope="row">
                            @if (final && e.Rank == 1)
                            {
                                <span title="Winner">&#9733;</span>
                            }
                            else
                            {
                                @e.Rank
                            }
                        </th>
                        <td>
                            @e.Name
                            @if (e.PlayerId == me!.IntlGameId)
                            {
                                <span class="badge bg-primary ms-1">you</span>
                            }
                        </td>
                        @if (!final)
                        {
                            <td class="text-end">
                                @if (!e.AnsweredLast)
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                                else if (e.LastWasCorrect)
                                {
                                    <span class="text-success">+@e.LastPoints</span>
                                }
                                else
                                {
                                    <span class="text-danger">0</span>
                                }
                            </td>
                        }
                        <td class="text-end fw-bold" style="font-variant-numeric: tabular-nums;">@e.Score</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>;
}
