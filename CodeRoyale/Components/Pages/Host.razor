@page "/host"
@using CodeRoyale.Live
@inject GameService Games
@inject NavigationManager Nav

<PageTitle>Host a game</PageTitle>

<h1>Host a game</h1>
<p class="text-muted">Pick a deck, choose a name, and share the join code. No account needed.</p>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="mb-4" style="max-width: 24rem;">
    <label class="form-label" for="hostName">Your name</label>
    <input id="hostName" class="form-control" @bind="hostName" @bind:event="oninput" maxlength="32"
           placeholder="e.g. Rahul" />
</div>

<h2 class="h5">Choose a deck</h2>
<div class="row g-3">
    @foreach (QuestionDeck deck in BuiltInDecks.All)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title h6">@deck.Name</h3>
                    <p class="card-text small text-muted flex-grow-1">@deck.Description</p>
                    <p class="card-text small mb-3">
                        <strong>@deck.Questions.Count</strong> questions &middot;
                        <strong>@deck.SecondsPerQuestion</strong>s each
                    </p>
                    <button class="btn btn-primary" @onclick="() => StartHosting(deck)">
                        Host this deck
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string hostName = string.Empty;
    private string? error;

    private void StartHosting(QuestionDeck deck)
    {
        error = null;

        if (string.IsNullOrWhiteSpace(hostName))
        {
            error = "Enter your name first so players can see who is hosting.";
            return;
        }

        (LiveGame game, LivePlayer host) = Games.CreateGame(hostName, deck);
        Nav.NavigateTo($"/play/{game.JoinCode}?p={host.Id}");
    }
}
