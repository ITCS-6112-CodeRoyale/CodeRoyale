@page "/join"
@using CodeRoyale.Data
@using CodeRoyale.Data.Games
@using CodeRoyale.Identity
@using CodeRoyale.Live

@inject GameService Games
@inject NavigationManager Nav
@inject ApplicationUserProvider UserProvider

<PageTitle>Join a game | CodeRoyale</PageTitle>

<div class="page-header">
    <div class="eyebrow">~/join</div>
    <h1>Join a game</h1>
    <p>Enter the code the host gave you. No account needed.</p>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card-surface form-card">

    <div class="mb-3">
        <label class="form-label" for="code">Join code</label>
        <input id="code" class="form-control form-control-lg code-input" @bind="code" @bind:event="oninput"
               maxlength="6" autocomplete="off" spellcheck="false" placeholder="ABC234" />
        <div class="form-text">6 characters. Letters I and O and digits 1 and 0 are never used.</div>
    </div>

    @if (_user == null)
    {
        <div class="mb-3">
            <label class="form-label" for="nickname">Your nickname</label>
            <input id="nickname" class="form-control" @bind="nickname" @bind:event="oninput" maxlength="32"
                   placeholder="e.g. Ada" />
        </div>
    }
    else
    {
        <p class="mb-3">You will join as <strong>@_user.GetDisplayName()</strong></p>
    }

    <button class="btn btn-primary btn-lg w-100" @onclick="JoinGame" disabled="@(!CanJoin)">Join game</button>
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    private string? CodeFromQuery { get; set; }

    private string code = string.Empty;
    private string nickname = string.Empty;
    private string? error;
    private ApplicationUser? _user;

    private bool CanJoin => JoinCode.IsWellFormed(code) && (_user != null || !string.IsNullOrWhiteSpace(nickname));

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(CodeFromQuery))
        {
            code = JoinCode.Normalize(CodeFromQuery);
        }

        _user = await UserProvider.GetLoggedInUserAsync();
    }

    private void JoinGame()
    {
        error = null;

        string normalised = JoinCode.Normalize(code);
        if (normalised.Length != JoinCode.Length)
        {
            error = "That code does not look right. It should be 6 characters.";
            return;
        }

        string name = _user?.GetDisplayName() ?? nickname;

        (GamePlayer? player, string? reason) = Games.Join(normalised, name, _user);
        if (player is null)
        {
            error = reason ?? "Could not join that game.";
            return;
        }

        Nav.NavigateTo($"/play/{normalised}?p={player.IntlGameId}");
    }
}