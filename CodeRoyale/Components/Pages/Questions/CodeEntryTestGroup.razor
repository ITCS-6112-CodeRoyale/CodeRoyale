@{
    @foreach (CodeEntryTest test in Tests.OrderBy(x => x.Index))
    {
        switch (test)
        {
            case CodeEntryUnitTest utest:
                <CodeEntryUnitTestEditor Question="@Question" Test="@utest" IsCorrect="@IsCorrect" OnDeleted="OnDeleteAsync"/>
                break;
            case CodeEntryRegexTest rtest:
                <CodeEntryRegExTestEditor Question="@Question" Test="@rtest" IsCorrect="@IsCorrect" OnDeleted="OnDeleteAsync" />
                break;
        }
    }
}

@code {

    [Parameter]
    public required IList<CodeEntryTest> Tests { get; set; }

    [Parameter]
    public required CodeEntryQuestion Question { get; set; }

    [Parameter]
    public required bool IsCorrect { get; set; }
    
    [Parameter]
    public EventCallback<CodeEntryTest> OnDeleted { get; set; }

    private Task OnDeleteAsync(CodeEntryTest test)
    {
        return OnDeleted.InvokeAsync(test);
    }
}